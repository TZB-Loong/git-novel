---
// src/components/Footer.astro
import { SITE_CONFIG } from '../lib/config';
const baseURL = import.meta.env.BASE_URL;
const year = new Date().getUTCFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <small>记录正在发生的事，也记录正在成形的想法。</small>
    <div class="footer-links">
    <a href={`https://github.com/${SITE_CONFIG.author}`} target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>
  <div style="max-width:var(--max-width);margin:1.3rem auto 0;"><small>&copy; {year} {SITE_CONFIG.author}</small></div>
</footer>
