---
// src/components/NoteCard.astro
import { formatDate } from '../lib/date';
import NoteCoverImage from './NoteCoverImage.astro';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      pubDate: Date;
      cover?: string;
      tags?: string[];
    };
  };
}

const { entry } = Astro.props;
const baseURL = import.meta.env.BASE_URL;
const tags = entry.data.tags ?? [];
---
<a href={`${baseURL}notes/${entry.id}/`} class="note-card-link">
  <article class="note-card">
    <div class="note-card-media">
      <NoteCoverImage entry={entry} className="note-card-image" width={640} height={400} />
    </div>
    <div class="note-card-body">
      <div class="note-card-top">
        <span class="eyebrow">Field note</span>
        <time class="note-card-date" datetime={entry.data.pubDate.toISOString()}>
          {formatDate(entry.data.pubDate)}
        </time>
      </div>
      <h3>{entry.data.title}</h3>
      {tags.length > 0 && (
        <div class="note-card-tags">
          {tags.slice(0, 3).map((tag) => (
            <span class="note-tag">{tag}</span>
          ))}
        </div>
      )}
    </div>
  </article>
</a>
