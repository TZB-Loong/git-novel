---
// src/components/NoteCard.astro
import { formatDate } from '../lib/date';
import { Image } from 'astro:assets';

interface Props {
  entry: {
    id: string;
    data: { title: string; pubDate: Date; cover: string };
  };
}
const { entry } = Astro.props;
const baseURL = import.meta.env.BASE_URL;

// Load cover via eager glob (Vite-resolved at build time, avoids dynamic import limitations)
const coverImages = import.meta.glob<{ default: import('astro/assets').ImageMetadata }>(
  '/src/assets/**/*.{svg,png,jpg,jpeg,gif,webp}',
  { eager: true },
);
const coverKey = `/src/assets/${entry.data.cover}`;
const coverModule = coverImages[coverKey] ?? null;
---
<a href={`${baseURL}notes/${entry.id}/`} style="display:block;color:inherit;">
  <article class="note-card">
    {coverModule ? (
      <Image src={coverModule.default} alt={entry.data.title} width={400} height={225} />
    ) : (
      <div style="width:100%;height:225px;background:var(--color-card-bg);display:flex;align-items:center;justify-content:center;color:var(--color-muted);">无封面</div>
    )}
    <div class="note-card-body">
      <span class="eyebrow">Note</span>
      <h3>{entry.data.title}</h3>
      <small class="meta">{formatDate(entry.data.pubDate)}</small>
    </div>
  </article>
</a>
