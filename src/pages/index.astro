---
// src/pages/index.astro
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import { sortByDateDesc } from '../lib/date';
import { SITE_CONFIG } from '../lib/config';

const notes = await getCollection('notes');
const visibleNotes = notes.filter((n) => !n.data.draft || import.meta.env.DEV);

const latestNoteCards = sortByDateDesc(visibleNotes).slice(0, 12);

const baseURL = import.meta.env.BASE_URL;
---
<BaseLayout title={SITE_CONFIG.title} description={SITE_CONFIG.description}>
  <section class="home-intro">
    <div>
      <span class="eyebrow">Personal knowledge journal</span>
      <h1 class="page-title">把想法，留在<br />时间里。</h1>
      <p>用图片保存灵感，用文字整理那些还在慢慢成形的观察。</p>
    </div>
    <div class="intro-mark" aria-hidden="true">记<br />事</div>
  </section>

  <section>
    <div class="section-heading">
      <h2>图片笔记</h2>
      <a class="section-link" href={`${baseURL}notes/`}>浏览全部 ↗</a>
    </div>
    <div class="content-grid">
      {latestNoteCards.map((entry: CollectionEntry<'notes'>) => (
        <NoteCard entry={entry} />
      ))}
      {latestNoteCards.length === 0 && <p class="meta">暂无图片笔记。</p>}
    </div>
  </section>
</BaseLayout>
