---
// src/pages/index.astro
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import NoteCoverImage from '../components/NoteCoverImage.astro';
import { formatDate, sortByDateDesc } from '../lib/date';
import { SITE_CONFIG } from '../lib/config';

const notes = await getCollection('notes');
const visibleNotes = notes.filter((n) => !n.data.draft || import.meta.env.DEV);
const sortedNotes = sortByDateDesc(visibleNotes.filter((n) => Boolean(n.data.cover)));

const latest = sortedNotes[0] ?? null;
const recentCards = sortedNotes.slice(0, 6);

const tagCounts = new Map<string, number>();
for (const note of visibleNotes) {
  for (const tag of note.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);

const years = visibleNotes.map((n) => n.data.pubDate.getUTCFullYear());
const startYear = years.length > 0 ? Math.min(...years) : 2026;
const endYear = years.length > 0 ? Math.max(...years) : 2026;
const yearLabel = startYear === endYear ? String(startYear) : `${startYear}-${endYear}`;

const baseURL = import.meta.env.BASE_URL;
---
<BaseLayout title={SITE_CONFIG.title} description={SITE_CONFIG.description}>
  <section class="home-intro">
    <div class="hero-copy">
      <span class="eyebrow">Personal knowledge journal</span>
      <h1 class="page-title">把想法，留在<br />时间里。</h1>
      <p>
        用图片保存灵感，用文字整理那些还在慢慢成形的观察。这里是关于 AI、工程与持续思考的图文记录。
      </p>
      <div class="hero-actions">
        <a class="button" href={`${baseURL}notes/`}>
          浏览全部笔记 <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href={`${baseURL}resume/`}>
          查看简历 <span aria-hidden="true">↗</span>
        </a>
      </div>
      <dl class="hero-stats">
        <div>
          <dt>{visibleNotes.length}</dt>
          <dd>篇图文笔记</dd>
        </div>
        <div>
          <dt>{topTags.length}</dt>
          <dd>个热门主题</dd>
        </div>
        <div>
          <dt>{yearLabel}</dt>
          <dd>记录时间跨度</dd>
        </div>
      </dl>
    </div>

    {latest && (
      <a class="hero-feature" href={`${baseURL}notes/${latest.id}/`}>
        <div class="hero-feature-media">
          <NoteCoverImage
            entry={latest}
            className="hero-feature-image"
            width={1000}
            height={625}
            sizes="(max-width: 720px) 100vw, 52vw"
          />
        </div>
        <div class="hero-feature-content">
          <span class="feature-index">01 / Latest</span>
          <div>
            <span class="feature-date">{formatDate(latest.data.pubDate)}</span>
            <h2>{latest.data.title}</h2>
            {latest.data.tags && latest.data.tags.length > 0 && (
              <div class="hero-feature-tags">
                {latest.data.tags.slice(0, 3).map((tag) => (
                  <span class="note-tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </div>
      </a>
    )}
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Recent field notes</span>
        <h2>最近记录</h2>
      </div>
      <a class="section-link" href={`${baseURL}notes/`}>
        查看全部 <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="content-grid">
      {recentCards.map((entry: CollectionEntry<'notes'>) => (
        <NoteCard entry={entry} />
      ))}
      {recentCards.length === 0 && <p class="meta">暂无图片笔记。</p>}
    </div>
  </section>

  {topTags.length > 0 && (
    <section class="topic-section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Topics</span>
          <h2>常写主题</h2>
        </div>
      </div>
      <div class="topic-cloud">
        {topTags.map((item) => (
          <a class="topic-chip" href={`${baseURL}notes/?tag=${encodeURIComponent(item[0])}`}>
            <span>{item[0]}</span>
            <i>{item[1]}</i>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
