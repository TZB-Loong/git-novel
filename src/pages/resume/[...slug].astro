---
// src/pages/resume/[...slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('resume');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'resume'>;
}

const { entry } = Astro.props;
const resume = entry.data;

const baseURL = import.meta.env.BASE_URL;
const workCount = resume.experience?.length ?? 0;
const projectCount = resume.projects?.length ?? 0;
const sectionCount = workCount + projectCount;
---
<BaseLayout
  title={`${resume.name} · 简历`}
  description={resume.tagline || resume.objective}
>
  <article class="resume-page">
    <a class="back-link" href={`${baseURL}resume/`}>&larr; 返回简历列表</a>

    <header class="resume-header">
      <div class="resume-identity">
        <span class="eyebrow">Resume</span>
        <h1 class="resume-name">{resume.name}</h1>
        <p class="resume-tagline">{resume.tagline || resume.objective}</p>
        <p class="resume-contact">
          邮箱:<span class="resume-email" data-user={resume.emailUser} data-domain={resume.emailDomain}>点击显示</span>
        </p>
      </div>
      <div class="resume-facts">
        <div>
          <span>求职意向</span>
          <strong>{resume.objective}</strong>
        </div>
        <div>
          <span>经历</span>
          <strong>{sectionCount > 0 ? `${sectionCount} 段工作 / 项目` : '待补充'}</strong>
        </div>
        <div>
          <span>技能</span>
          <strong>{resume.skills?.length ? `${resume.skills.length} 个方向` : '待补充'}</strong>
        </div>
      </div>
    </header>

    <div class="resume-layout">
      <aside class="resume-aside">
        {resume.summary && (
          <section class="resume-section">
            <h2 class="section-title">自我评价</h2>
            <p class="section-body">{resume.summary}</p>
          </section>
        )}

        {resume.strengths && resume.strengths.length > 0 && (
          <section class="resume-section">
            <h2 class="section-title">核心优势</h2>
            <ul class="resume-list">
              {resume.strengths.map((item) => (
                <li>
                  <strong>{item.title}</strong>
                  <span>{item.detail}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {resume.skills && resume.skills.length > 0 && (
          <section class="resume-section">
            <h2 class="section-title">专业技能</h2>
            <ul class="resume-list">
              {resume.skills.map((item) => (
                <li>
                  <strong>{item.name}</strong>
                  <span>{item.detail}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>

      <div class="resume-main">
        {resume.experience && resume.experience.length > 0 && (
          <section class="resume-section">
            <h2 class="section-title">工作经历</h2>
            {resume.experience.map((job) => (
              <div class="job">
                <div class="job-head">
                  <h3 class="job-company">{job.company}</h3>
                  <span class="job-period">{job.period}</span>
                </div>
                <p class="job-role">
                  {job.role}
                  {job.industry && <span class="job-industry">{job.industry}</span>}
                </p>
                {job.summary && <p class="job-summary">{job.summary}</p>}
                <ul class="job-points">
                  {job.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        )}

        {resume.projects && resume.projects.length > 0 && (
          <section class="resume-section">
            <h2 class="section-title">项目经历</h2>
            {resume.projects.map((project) => (
              <div class="job">
                <div class="job-head">
                  <h3 class="job-company">{project.name}</h3>
                  <span class="job-period">{project.period}</span>
                </div>
                <p class="job-role">{project.role}</p>
                {project.sections.map((section) => (
                  <div class="project-section">
                    <h4 class="project-section-title">{section.title}</h4>
                    <ul class="job-points">
                      {section.points.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            ))}
          </section>
        )}

        {workCount === 0 && projectCount === 0 && (
          <p class="meta">暂无工作与项目经历。</p>
        )}
      </div>
    </div>

    <section class="resume-bottom">
      <section class="resume-section">
        <h2 class="section-title">教育经历</h2>
        <div class="job education-job">
          <div class="job-head">
            <h3 class="job-company">{resume.education.school}</h3>
            <span class="job-period">{resume.education.period}</span>
          </div>
          <p class="job-role">
            {resume.education.degree}
            {resume.education.major && <span> · {resume.education.major}</span>}
          </p>
        </div>
      </section>

      {resume.certificates && resume.certificates.length > 0 && (
        <section class="resume-section">
          <h2 class="section-title">证书与语言</h2>
          <ul class="resume-tags">
            {resume.certificates.map((certificate) => (
              <li>{certificate}</li>
            ))}
          </ul>
        </section>
      )}
    </section>
  </article>

  <script>
    document.querySelectorAll('.resume-email').forEach((el) => {
      const user = el.dataset.user || '';
      const domain = el.dataset.domain || '';
      const address = `${user}@${domain}`;
      const link = document.createElement('a');
      link.href = `mailto:${address}`;
      link.textContent = address;
      el.textContent = '';
      el.appendChild(link);
    });
  </script>
</BaseLayout>

<style>
  .resume-page {
    max-width: 1080px;
    margin: 0 auto;
  }

  .back-link {
    margin-bottom: var(--space-6);
  }

  .resume-header {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding: 2rem 0 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .resume-identity {
    min-width: 0;
  }

  .resume-name {
    margin: 0.6rem 0 0.8rem;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .resume-tagline {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .resume-contact {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .resume-email a {
    color: var(--color-accent);
    font-weight: 700;
  }

  .resume-facts {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .resume-facts > div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .resume-facts span {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .resume-facts strong {
    color: var(--color-fg-soft);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .resume-layout {
    display: grid;
    grid-template-columns: minmax(260px, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .resume-aside {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
    min-width: 0;
  }

  .resume-main {
    min-width: 0;
  }

  .resume-section {
    margin-bottom: var(--space-8);
  }

  .section-title {
    display: inline-block;
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-accent);
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-body {
    margin: 0;
    color: var(--color-fg);
    line-height: 1.85;
  }

  .resume-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resume-list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-border);
    line-height: 1.7;
  }

  .resume-list li strong {
    color: var(--color-fg);
    font-size: 0.95rem;
  }

  .resume-list li span {
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .job {
    margin-bottom: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
  }

  .job:last-child {
    margin-bottom: 0;
  }

  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .job-company {
    margin: 0;
    color: var(--color-fg);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .job-period {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .job-role {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 var(--space-3);
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .job-industry {
    padding: 1px var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .job-summary {
    margin: 0 0 var(--space-3);
    color: var(--color-muted);
    line-height: 1.75;
    font-size: 0.92rem;
  }

  .job-points {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding-left: 1.2rem;
    color: var(--color-fg-soft);
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .project-section {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border);
  }

  .project-section-title {
    margin: 0 0 var(--space-2);
    color: var(--color-accent);
    font-size: 0.86rem;
    font-weight: 750;
  }

  .resume-bottom {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .education-job {
    background: transparent;
    padding: 0;
    border: none;
  }

  .resume-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resume-tags li {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-elevated);
    color: var(--color-fg-soft);
    font-size: 0.85rem;
  }

  @media (max-width: 860px) {
    .resume-header {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .resume-layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .resume-aside {
      position: static;
    }

    .resume-bottom {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .resume-page {
      max-width: none;
      margin: 0;
    }

    .back-link {
      display: none;
    }

    .resume-header {
      grid-template-columns: 1fr;
      padding-top: 0;
    }

    .resume-layout {
      grid-template-columns: 1fr;
    }

    .resume-aside {
      position: static;
    }

    .job {
      padding: var(--space-3);
      border-color: #ccc;
      break-inside: avoid;
    }
  }
</style>
